# Variabile de mediu ale funcției API pentru proiectul samwera-board-eu.
# Firebase CLI încarcă acest fișier (împreună cu `.env`) la `firebase deploy --project samwera-board-eu`.
# NU pune aici secrete (cheia Azure e în Secret Manager: `firebase functions:secrets:set`).

# Originile care pot apela API-ul din browser (CORS). Fără această variabilă, apelurile
# cross-origin (OCR direct către Cloud Run) sunt refuzate.
FRONTEND_ORIGIN=https://cabinio.web.app

# Cheia KEK din Cloud KMS (UE) pentru vault-ul de CNP — se creează cu scripts/setup_kms.sh
VAULT_KMS_KEY=projects/samwera-board-eu/locations/europe-west3/keyRings/samwera/cryptoKeys/vault-kek

# Endpoint-ul resursei Azure Document Intelligence (Sweden Central, UE). Cheia NU e aici: e secret în Secret Manager.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://samwera.cognitiveservices.azure.com

# Contul de serviciu cu care rulează funcția (drepturi minime) — se creează o singură dată, vezi docs/vault-rollout.md secțiunea 1.
RUNTIME_SERVICE_ACCOUNT=api-runtime@samwera-board-eu.iam.gserviceaccount.com
SIGNUP_MODE=invite

# Sugestii AI opționale la import de șablon (ai_suggest.py) — Gemini prin Vertex AI, pe acest proiect. Contul de
# serviciu de mai sus are nevoie de rolul roles/aiplatform.user (vezi comanda gcloud din raportul de implementare).
# Model ales 2026-09-24 — de reverificat periodic în Model Garden, seria se schimbă des (Gemini 2.5 se dezactivează
# ~16 oct. 2026). „gemini-3.5-flash-lite” a dat 404 („Publisher model ... was not found”) în europe-west3 —
# varianta „Lite” pare disponibilă doar prin regiunea multi-UE, nu regional; „gemini-3.5-flash” (fără „-lite”)
# e cel mai ieftin confirmat direct pe europe-west3.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LOCATION=europe-west3
