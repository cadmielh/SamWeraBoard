# Extragere CI: OCR local (EasyOCR, gratuit) rulează întotdeauna primul; dacă scorul de
# calitate e sub prag (local_extractor.QUALITY_THRESHOLD), se face fallback pe Azure AI
# Document Intelligence (model prebuilt-idDocument) — vezi variabilele Azure mai jos.

# Endpoint-ul resursei Azure AI Document Intelligence (NU e secret, doar URL) — creați
# resursa în regiune UE pentru rezidența datelor. Ex: https://<resursa>.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com

# Cheia resursei Azure — IMPORTANT: puneți cheia reală în .env.local, NU aici. Firebase
# Functions bundlează .env ca variabile de mediu simple la deploy, ceea ce intră în conflict
# cu SecretParam-ul omonim din main.py (eroare "Secret environment variable overlaps non
# secret environment variable"). .env.local nu e niciodată încărcat la deploy, doar de
# emulator/dev local.
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_azure_document_intelligence_key_here

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex())")
FLASK_SECRET_KEY=change_this_to_a_random_secret

# Google OAuth2 credentials — download credentials.json from Google Cloud Console
# Enable: Google Drive API, Google Docs API
GOOGLE_CLIENT_SECRETS_FILE=credentials.json

# Origini CORS permise (separate prin virgulă). Fără fallback "*": dacă lipsește,
# niciun apel cross-origin nu e acceptat. Local: frontend-ul Vite.
FRONTEND_ORIGIN=http://localhost:5173

# Upload folder for temporary files
UPLOAD_FOLDER=uploads

# Vault-ul de date sensibile (CNP, serie CI) — vezi vault.py.
# Producție: calea cheii Cloud KMS din regiunea UE, ex.
#   projects/<proiect>/locations/europe-west3/keyRings/<inel>/cryptoKeys/<cheie>
# Serviciul are nevoie de rolul roles/cloudkms.cryptoKeyEncrypterDecrypter pe acea cheie.
VAULT_KMS_KEY=
# DOAR dezvoltare/teste: 32 de octeți în base64 (python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())").
# Fără niciuna dintre cele două, vault-ul refuză să funcționeze (nu există cheie implicită).
VAULT_LOCAL_KEK=
