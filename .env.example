# Extraction mode
# LOCAL_OCR=true  → use EasyOCR on-device, no API key needed (first run downloads ~500 MB model)
# LOCAL_OCR=false → use Claude Vision API (requires ANTHROPIC_API_KEY below)
LOCAL_OCR=true

# Anthropic API Key — only needed when LOCAL_OCR=false
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex())")
FLASK_SECRET_KEY=change_this_to_a_random_secret

# Google OAuth2 credentials — download credentials.json from Google Cloud Console
# Enable: Google Drive API, Google Docs API
GOOGLE_CLIENT_SECRETS_FILE=credentials.json

# Upload folder for temporary files
UPLOAD_FOLDER=uploads

# demoanaf.ro API key — sursă principală pentru /anaf/company (date ANAF+ONRC live, fără dansul async oficial)
# Cont gratuit: https://demoanaf.ro/cont
# IMPORTANT: pune cheia reală în .env.local, NU aici — Firebase Functions bundlează
# .env ca variabile de mediu simple la deploy, ceea ce intră în conflict cu SecretParam-ul
# omonim din main.py (eroare "Secret environment variable overlaps non secret environment
# variable"). .env.local nu e niciodată încărcat la deploy, doar de emulator/dev local.
DEMOANAF_API_KEY=your_demoanaf_api_key_here
