rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    // Tot accesul cere cont cu e-mail verificat.
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function workspace(wid) {
      return get(/databases/$(database)/documents/workspaces/$(wid)).data;
    }
    // Rolul utilizatorului în workspace ('admin' | 'member' | 'viewer') sau null.
    // Membership-ul (workspaces/{wid}.members) se scrie DOAR de server (Admin SDK,
    // vezi workspaces_api.py) — clienții nu-l pot modifica (vezi regulile de mai jos).
    function roleOf(wid) {
      return signedIn() && request.auth.uid in workspace(wid).members
        ? workspace(wid).members[request.auth.uid].role
        : null;
    }
    function isMember(wid)  { return roleOf(wid) != null; }
    function canWrite(wid)  { return roleOf(wid) in ['admin', 'member']; }
    function isAdmin(wid)   { return roleOf(wid) == 'admin'; }

    // Rol de aplicație (independent de orice workspace) — users/{uid}.isSuperAdmin.
    function isSuperAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isSuperAdmin', false) == true;
    }

    // Id-ul de document derivat din e-mailul utilizatorului curent, folosit
    // pentru superAdminGrants/{docId} — oglinda encodeEmail() din frontend
    // ('.' -> '_DOT_', apoi '@' -> '_AT_'). replace() înlocuiește doar prima
    // apariție, deci trecerile suplimentare sunt no-op inofensive.
    function ownEmailDocId() {
      return request.auth.token.email.lower()
        .replace('\\.', '_DOT_').replace('\\.', '_DOT_')
        .replace('\\.', '_DOT_').replace('\\.', '_DOT_')
        .replace('\\.', '_DOT_').replace('\\.', '_DOT_')
        .replace('\\.', '_DOT_').replace('\\.', '_DOT_')
        .replace('@', '_AT_');
    }

    // Un grant de super admin în așteptare, nefolosit, pentru e-mailul propriu.
    function hasValidSuperAdminGrant() {
      let path = /databases/$(database)/documents/superAdminGrants/$(ownEmailDocId());
      return exists(path) && get(path).data.get('used', false) != true;
    }

    // ── users ──────────────────────────────────────────────────────────────
    // isSuperAdmin poate trece doar din nesetat/false în true, doar cu un grant
    // valid pentru e-mailul propriu. Dezactivarea se face manual (Console/Admin SDK).
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.get('isSuperAdmin', false) == false;
      allow update: if signedIn() && request.auth.uid == uid && (
        request.resource.data.get('isSuperAdmin', false) == resource.data.get('isSuperAdmin', false) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isSuperAdmin']) &&
          request.resource.data.isSuperAdmin == true &&
          hasValidSuperAdminGrant()
        )
      );
    }
    // Doar subcolecții reale — nu `/users/{uid}/{document=**}`, care ar potrivi
    // și documentul părinte și ar ocoli protecția isSuperAdmin de mai sus.
    match /users/{uid}/{subcollection}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid && subcollection != 'extractions';
    }
    // Istoric extrageri: doar metadate (sursă, moment, expirare). Orice alt câmp — în special
    // datele personale extrase din acte — e refuzat; sunt permise doar citirea și ștergerea.
    match /users/{uid}/extractions/{id} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['createdAt', 'sourceFile', 'expireAt']);
      allow update: if false;
    }

    // ── workspaces ─────────────────────────────────────────────────────────
    match /workspaces/{wid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // Super adminii văd toate workspace-urile (pagina /super-admin).
      allow read: if isSuperAdmin();

      // Creare, membri, roluri, ownerId, consimțământ, status: doar server-side.
      allow create: if false;
      allow delete: if false;

      // Adminul de workspace poate modifica doar numele și configurul de facturare.
      allow update: if isAdmin(wid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'facturareConfig']);
      // Super adminul poate comuta doar feature flag-urile.
      allow update: if isSuperAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['features']);

      // Clienți — date personale (CNP etc.): citire pentru orice membru,
      // scriere pentru admin/member, ștergere doar prin API (admin).
      match /clienti/{clientId} {
        allow read: if isMember(wid);
        allow create: if canWrite(wid);
        allow update: if canWrite(wid) &&
          request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null);
        // Ștergerea trece exclusiv prin API (DELETE /clients/<id>, doar admin): șterge
        // în cascadă și vault-ul de CNP/serie CI + istoricul, ca să nu rămână date orfane.
        allow delete: if false;

        // Vault-ul de date sensibile (pii/vault) NU are reguli => acces interzis din
        // client. Citirea/scrierea în clar trece doar prin pii_api.py, cu audit.

        // Istoric generări documente — append-only.
        match /docGenerations/{genId} {
          allow read: if isMember(wid);
          allow create: if canWrite(wid);
          allow update, delete: if false;
        }
      }

      match /docTemplates/{templateId} {
        allow read: if isMember(wid);
        allow create, update, delete: if canWrite(wid);
      }

      match /dosare/{dosarId} {
        allow read: if isMember(wid);
        allow create: if canWrite(wid);
        allow update: if canWrite(wid) &&
          request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null);
        allow delete: if canWrite(wid);
      }

      match /sarcini/{sarcinaId} {
        allow read: if isMember(wid);
        allow create: if canWrite(wid);
        allow update: if canWrite(wid) &&
          request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null);
        allow delete: if canWrite(wid);
      }

      // Jurnal de audit — scris exclusiv de server; citit doar de admini.
      match /auditLog/{entryId} {
        allow read: if isAdmin(wid);
        allow write: if false;
      }
    }

    // ── workspaceKeys ──────────────────────────────────────────────────────
    // Chei de date (învelite cu KMS) pentru vault-ul de CNP. Doar server-side.
    match /workspaceKeys/{wid} {
      allow read, write: if false;
    }

    // ── rateLimits ─────────────────────────────────────────────────────────
    // Contoare pentru limitarea cererilor (ratelimit.py). Doar server-side.
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // ── invitations ────────────────────────────────────────────────────────
    // Create/accept/decline/revoke se fac exclusiv prin API (workspaces_api.py):
    // acceptarea e explicită și verificată server-side. Niciun acces din client.
    match /invitations/{inviteId} {
      allow read, write: if false;
    }

    // Cine poate crea cabinete (înregistrare pe invitație): doar prin API.
    match /workspaceCreators/{id} {
      allow read, write: if false;
    }

    // ── superAdminGrants ───────────────────────────────────────────────────
    match /superAdminGrants/{encodedEmail} {
      allow read: if signedIn() &&
        (isSuperAdmin() || resource.data.email == request.auth.token.email.lower());
      allow create, delete: if isSuperAdmin();
      allow update: if signedIn() &&
        resource.data.email == request.auth.token.email.lower() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used']) &&
        request.resource.data.used == true;
    }
  }
}
