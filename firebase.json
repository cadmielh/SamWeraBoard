  ],
  "functions": [
    {
      "source": ".",
      "codebase": "default",
      "runtime": "python312",
      "memory": "1GiB",
      "cpu": 1,
      "secrets": [
        "AZURE_DOCUMENT_INTELLIGENCE_KEY"
      ],
      "ignore": [
        "venv",
        ".venv",
        "node_modules",
        "**/node_modules/**",
        "__pycache__",
        "**/__pycache__/**",
        "*.pyc",
        ".pytest_cache",
        "frontend",
        "tests",
        "docs",
        "scripts",
        ".claude",
        ".git",
        "static",
        "templates",
        "*.md",
        "preview.html",
        "lf_test.html",
        ".env",
        ".env.*",
        "*.local",
        "firebase-service-account.json",
        "credentials.json",
        "token.json",
        "*.pem",
        "*.key",
        "SabloaneAvocatTavi",
        "*_original.docx",
        "*.xlsx",
