{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api",
        "region": "us-central1"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|woff2|woff|ttf|eot)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.@(html|json)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": ".",
      "codebase": "default",
      "runtime": "python312",
      "environmentVariables": {
        "UPLOAD_FOLDER": "/tmp/uploads",
        "FRONTEND_ORIGIN": "https://samwera-board.web.app,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000"
      },
      "secrets": ["OPENROUTER_API_KEY", "OPENAPI_RO_KEY", "LISTAFIRME_KEY"]
    }
  ]
}
